# 由 scripts/preconfig-kernel.sh 生成（LTO_MODE=full）。
# 本内核树里只有 LTO_CLANG_THIN / LTO_CLANG_FULL 两个 choice 成员，
# 并【没有】名为 THINLTO 的符号（用 scripts/config -e THINLTO 会直接失败）。
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_FULL=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_NONE is not set
# CONFIG_DEBUG_INFO is not set
