# =============================================================================
# 小米 12S Pro (unicorn) + LineageOS 23.2  5.10.269 GKI
# 容器（Docker / Droidspaces / chroot）所需内核配置 + ReSukiSU
#
# ⚠️ 2026-10-24 起，本文件已改为【增量式】：
#    构建基底不再手工 merge gki_defconfig + 4 个碎片，而是直接使用
#    reference/device-config.txt（= 设备 /proc/config.gz 的真实导出）。
#    理由见 .workbuddy/memory/MEMORY.md「配置基底」一节：
#      · 设备配置是 ABI 的唯一权威（vendor 模块就是按它编的）
#      · 手工 merge 的产物会在一些边角项上与设备不同，而其中任何一项
#        若 gate 了结构体成员，就会导致模块集体拒载（卡米标）
#      · 设备配置自带 SYSVIPC=y / POSIX_MQUEUE=y / IPC_NS=y / PID_NS=y /
#        USER_NS=y —— 所以以前那些"不能开 SYSVIPC"的结论已经过期，
#        现在【必须】与设备一致，否则 task_struct 少两个成员反而会崩
#
# 因此本文件只列「设备配置里没有、但我们要加」的项，
# 以及少量需要显式钉住（防止基底切换时漂移）的项。
#
# =============================================================================
# ★★★ ABI 铁律（"刷进去永远停在米标"的根因，务必先读）★★★
#
#   Android GKI 的内核与 vendor 模块是【分离编译】的：ROM 里
#   /vendor_dlkm/lib/modules/*.ko 在编译时把"它需要的每个内核符号的 CRC"
#   写进自己的 __versions 段；内核加载模块时比对自己算出的 CRC，不一致就拒载。
#   CRC 由 genksyms 从【类型定义】算出 ⇒ 任何改变"被导出符号可见的结构体
#   布局"的配置项，都会让相关模块全部拒载。
#
#   模块拒载的后果：显示驱动（msm_drm）也没加载 → 内核接手屏幕失败 →
#   【屏幕永远停在米标】，没有 panic、没有日志、pstore 空 —— 极难排查。
#
#   实测钉死的两个结构性开关（绝不要开）：
#     CONFIG_CGROUP_DEVICE / CONFIG_CGROUP_PIDS
#         include/linux/cgroup-defs.h:
#             struct css_set { ... subsys[CGROUP_SUBSYS_COUNT]; e_cset_node[CGROUP_SUBSYS_COUNT]; }
#         CGROUP_SUBSYS_COUNT = 已开启的 cgroup 子系统数，设备上是 7
#         （cpuset/cpu/cpuacct/io/memory/freezer/net_prio），一开这两个变 9
#         → 定长数组变长 → css_set / cgroup 布局变 → 295 个符号 CRC 变。
#         ★ 没有任何 KABI 保留槽手段能补"数组长度"，只能不开。
#         代价：拿不到 devices / pids 控制器（Docker 日志里
#         "Devices cgroup controller not available."、Droidspaces 的
#         "--pids-limit" / "Process limit support ✗" 都是它）。
#         要好起来只能连 vendor 模块一起重编重刷（不再是"只换 Image"）。
#     CONFIG_NF_TABLES
#         include/net/net_namespace.h: struct net 多一个 netns_nftables 成员。
#         （本 ROM 的 iptables 全族是 x_tables 传统后端，够用。）
#
#   注：CONFIG_SYSVIPC 与 CONFIG_POSIX_MQUEUE 在【本版 ROM】里原本就是 y，
#       属于"必须跟随设备"的项，不再是危险项 —— 这是 5.10.260 时代的
#       旧结论（那时设备两者皆 n），不要照搬。
#
#   刷机前必过 ABI 预检：scripts/check-abi-crc.py 会把本内核的符号 CRC 与
#   abi-baseline/abi-crcs.txt（由设备全部 390 个 .ko 生成，4188 个符号）
#   逐一比对，不一致就报红、别刷。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. cgroup 基础（设备本来就是这些值，钉住防止基底漂移）
#    ★ 这里【故意不写】 CGROUP_DEVICE / CGROUP_PIDS —— 见上面 ABI 铁律。
# -----------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y

# ❌ CONFIG_CFS_BANDWIDTH —— 实测会破 ABI，不能开（2026-10-25 有实锤了）
#
#   本来以为它「只改调度器内部结构」，结果 ABI 预检直接抓出 23 个失配符号，
#   全部落在 sched 子系统：
#     runqueues / root_task_group（变量，类型分别是 struct rq / struct task_group）
#     __task_rq_lock / activate_task / deactivate_task / resched_curr /
#     check_preempt_curr / set_task_cpu / set_cpus_allowed_ptr / sched_setattr /
#     sched_setscheduler(_nocheck) / sched_set_fifo / sched_set_normal /
#     sched_show_task / set_user_nice / wake_up_process / update_rq_clock /
#     uclamp_eff_value / task_may_not_preempt / migrate_swap / cpupri_find_fitness /
#     pick_highest_pushable_task
#
#   机理（比「结构体自己变」更绕一层）：CFS_BANDWIDTH 给 kernel/sched/sched.h 的
#   struct cfs_rq 加 throttled 相关字段、给 struct task_group 加
#   struct cfs_bandwidth cfs_bandwidth; 而 genksyms 算 CRC 时会【递归解析
#   嵌套类型】—— struct task_struct 里嵌着 struct sched_entity se，
#   sched_entity 里又有 struct cfs_rq *cfs_rq，于是 task_struct 的指纹跟着变，
#   凡是签名里带 task_struct* / rq* / task_group* 的导出符号全遭殃。
#
#   代价（如实说）：Droidspaces 的 --cpus / CPU 限额用不了（它会 skip）。
#   什么时候能要：只能连 vendor 模块一起重编重刷，那就不是「只换 Image」了。
#   ★ 不要因为「只有 23 个、数量少」就想着用 KABI 保留槽糊过去 ——
#     数组/嵌套结构体递归是保留槽补不了的（同上文 CGROUP_DEVICE 那条）。
# CONFIG_CFS_BANDWIDTH=y


# -----------------------------------------------------------------------------
# 2. 命名空间（★ 本版 24.0 官方配置里这四项全是 n，所以必须由我们打开）
#    【2026-10-25 实测】24.0-20261023 的 /proc/config.gz：
#        # CONFIG_SYSVIPC is not set / # CONFIG_POSIX_MQUEUE is not set
#        # CONFIG_PID_NS is not set / # CONFIG_USER_NS is not set
#        CONFIG_IPC_NS 连符号行都没有（依赖不满足）
#      ⇒ /proc/self/ns/ 只有 cgroup mnt net time uts，Droidspaces 的
#        MUST HAVE（PID/UTS/IPC namespace）直接过不了。
#
#    IPC_NS 的 Kconfig：depends on NAMESPACES && (SYSVIPC || POSIX_MQUEUE)
#    ★ 只能选 POSIX_MQUEUE，绝不能开 SYSVIPC ★
#      SYSVIPC 会给 struct task_struct 加 sysvsem/sysvshm → 所有相关导出符号
#      CRC 变 → vendor 模块集体拒载 → 卡米标，且没有任何保留槽能补。
#    POSIX_MQUEUE 的代价是 struct user_struct 多一个 mq_bytes（725 个符号），
#    但那个坑可以用 Android GKI 预留的 KABI 保留槽接住（ANDROID_KABI_USE），
#    CI 里的「ABI 安全补丁」步骤会按设备配置自动判断要不要打。
# -----------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
# ★★ 绝对不要写 CONFIG_SYSVIPC=y ★★
#    2026-10-24 曾为 23.2 设备"跟随"加过它（那版设备本身就是 y）；
#    24.0 设备是 n，再打开会让 task_struct 多成员 → 725 符号变 → 卡米标。


# -----------------------------------------------------------------------------
# 3. 网络
#    VETH / BRIDGE / OVERLAY_FS / TUN / FUSE_FS 设备已 y。
#
#    Droidspaces v7 新增要求：
#      CONFIG_MACVLAN                    → --net=macvlan
#      CONFIG_IP6_NF_NAT                 → IPv6 NAT 前缀
#      CONFIG_IP6_NF_TARGET_MASQUERADE   → --net=nat 的 IPv6 出网
#    注意 NF_NAT=y / NF_CONNTRACK=y 设备已开，所以 struct nf_conn 的
#    nat 相关成员已经在官方布局里，开 IPv6 NAT 只是新增代码路径，
#    理论上不动任何被导出的结构体（仍以 ABI 预检为准）。
#
#    ★ 仍然不开 NF_TABLES / NF_TABLES_BRIDGE / BRIDGE_NETFILTER：
#      NF_TABLES 会给 struct net 加成员；BRIDGE_NETFILTER 同理回避。
#      iptables 走 x_tables 传统后端即可。
# -----------------------------------------------------------------------------
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_OVERLAY_FS=y
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y


# -----------------------------------------------------------------------------
# 4. 安全 / BPF（设备已 y，钉住）
#    CGROUP_BPF=y 是 cgroup v2 设备控制（BPF_PROG_TYPE_CGROUP_DEVICE）的前提，
#    也正是"不开 CGROUP_DEVICE 也能做设备隔离"的依据。
# -----------------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y


# -----------------------------------------------------------------------------
# 5. devtmpfs —— Droidspaces「硬件访问模式」的前提（2026-10-25 补）
#
#   现象（Droidspaces v7.0.0 要求检查）：
#       [RECOMMENDED] devtmpfs support  [✗]
#       Required for hardware access mode; tmpfs fallback used otherwise
#   原因：LineageOS 23.2 的设备配置是 CONFIG_DEVTMPFS=y（所以那时硬件访问可用），
#         24.0 跟着 GKI 关掉了 → 现在是 # CONFIG_DEVTMPFS is not set。
#         这是"官方配置随版本漂移"，不是我们之前漏了什么。
#
#   为什么【可以开】（不是 ABI 危险项，已逐条核对源码）：
#     a) include/linux/device.h 里随开关变化的只有 devtmpfs_mount() 的【声明】，
#        #ifdef 两个分支的签名完全相同（int devtmpfs_mount(void)），
#        genksyms 是按类型算 CRC 的 → 一个符号都不动。
#     b) drivers/base/devtmpfs.c 里没有任何 EXPORT_SYMBOL*，不会新增导出符号。
#     c) 不碰 struct device / struct super_block / struct file_system_type
#        等任何被导出的结构体。
#   仍以 CI 的 ABI 预检为准：0 失配才刷机。
#
#   ★★ CONFIG_DEVTMPFS_MOUNT 必须保持 n ★★
#     =y 时 devtmpfs_mount() 会在 prepare_namespace 阶段把 devtmpfs 挂到 /dev，
#     而 Android 的 /dev 是 init 挂的 tmpfs + ueventd 填节点 —— 被抢占会直接起不来。
#     不影响容器用：5.10 的 devtmpfs_init() 与 mount_dev 无关，总会跑起
#     kdevtmpfs 线程建全量节点；public_dev_mount() 返回的是【同一个内核实例】
#     的 s_root ⇒ 容器里 mount -t devtmpfs 照样拿到完整设备节点树。
#     （以后 24.0 的正式配置若又把 DEVTMPFS 打开，这里会与设备一致，无害。）
# -----------------------------------------------------------------------------
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set


# -----------------------------------------------------------------------------
# 6. ReSukiSU —— 【已关闭】
#    用户明确表示只需要 Droidspaces v7.0.0 的能力，不需要 root 管理方案。
#    ci/build-flags.txt 里 KSU=off 时 workflow 会跳过源码集成，
#    并把碎片里的 CONFIG_KSU* 行全部剔除（否则 Kconfig 会报未知符号）。
#    以后若还需要，把 KSU=on 并取消下面三行注释即可。
# -----------------------------------------------------------------------------
# CONFIG_KSU=y
# CONFIG_KSU_TOOLKIT_SUPPORT=y
# CONFIG_KSU_MULTI_MANAGER_SUPPORT=y


# -----------------------------------------------------------------------------
# 7. 便于在手机上校验（设备已 y）
# -----------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PAGE_EXTENSION=y
