# =============================================================================
# 小米 12S Pro (unicorn) + LineageOS 23.2  5.10 GKI
# Docker / containerd 所需内核配置 + ReSukiSU
#
# 写入位置（重要）：
#   arch/arm64/configs/gki_defconfig   —— 即 defconfig 本体，追加到文件末尾
#
# 为什么不能写碎片：LineageOS 官方 device 树里是
#   TARGET_KERNEL_CONFIG := gki_defconfig vendor/waipio_GKI.config \
#                           vendor/xiaomi_GKI.config \
#                           vendor/$(PRODUCT_DEVICE)_GKI.config vendor/debugfs.config
#   gki_defconfig 是 base，其余全是碎片；碎片只能"新增"，改已有值会撞上
#   build.config.msm.common 的 "ERROR! Detected overridden config!" 直接失败。
#   而 CONFIG_PID_NS 在 base 里是 "# CONFIG_PID_NS is not set" → 必须改本体。
# =============================================================================
#
# ★★★ ABI 铁律（这是"刷进去永远停在米标"的根因，务必先读）★★★
#
#   Android GKI 的内核与 vendor 模块是【分离编译】的：ROM 里
#   /vendor/lib/modules/*.ko 在编译时把"它需要的每个内核符号的 CRC"写进了
#   自己的 __versions 段；内核加载模块时会比对自己算出来的 CRC，不一致就
#   直接拒绝加载。CRC 由 genksyms 从【类型定义】算出 —— 所以：
#
#     只要某个被导出符号签名涉及的结构体布局，与官方内核不同，CRC 就变，
#     该符号相关的模块全部拒载。
#
#   而模块拒载的后果是：显示驱动模块也没加载 → 内核接手屏幕失败 →
#   【屏幕永远停在米标】，没有 panic、没有日志、pstore 空 —— 极难排查。
#
#   本次实测踩到的两个结构性开关（都已从本文件移除）：
#     CONFIG_NF_TABLES=y   -> include/net/net_namespace.h:145
#                             #if defined(CONFIG_NF_TABLES) ... struct netns_nftables nft;
#                             struct net 多一个成员，所有含 struct net * 的导出符号 CRC 全变
#     CONFIG_SYSVIPC=y     -> include/linux/sched.h:973
#                             #ifdef CONFIG_SYSVIPC ... struct sysv_sem sysvsem; struct sysv_shm sysvshm;
#                             struct task_struct 多两个成员，影响面更大
#
#   下面这些【已验证是布局安全】的（它们只影响内核自身的实现，不改任何
#   被导出符号可见的结构体）：
#     CGROUP_DEVICE / CGROUP_PIDS（只加内部 cgroup 子系统）
#     PID_NS（struct pid_namespace 无条件定义，无条件成员）
#     USER_NS（struct cred.user_ns 等本来就是无条件字段）
#     IPC_NS + POSIX_MQUEUE（struct ipc_namespace 无条件定义，无条件成员）
#     KSU（ReSukiSU 本身就以"兼容 GKI 预编译模块"为设计目标）
#
#   刷机前可用 scripts/check-abi-crc.py 拿 ROM 模块的 CRC 与自编内核
#   Module.symvers 逐一比对，不一致就别刷（基线在 abi-baseline/abi-crcs.txt）。
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. cgroup 基础  —— 重点是 CONFIG_CGROUP_DEVICE
#    【设备实测】CGROUP_DEVICE 与 CGROUP_PIDS 都是 "# ... is not set"
#    （Kconfig 里 bool "Device controller" 没有 default y）。
#    Docker 的 devices 白名单、以及模块日志里的
#    "Devices cgroup controller not available." 都指向它。
#    （设备 /proc/cgroups 里确实没有 devices / pids 行，已实测确认。）
# -----------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y


# -----------------------------------------------------------------------------
# 2. 命名空间
#    【设备实测】NAMESPACES=y / NET_NS=y / UTS_NS=y 本来就是开的；
#      # CONFIG_PID_NS is not set                 -> 显式关闭（脚本改本体那一行）
#      # CONFIG_USER_NS is not set                -> 5.10 里 default n
#      CONFIG_IPC_NS 这一行【完全不存在】         -> 依赖未满足，见下
#
#    IPC namespace 的 Kconfig 是：
#      config IPC_NS
#          depends on NAMESPACES && (SYSVIPC || POSIX_MQUEUE)
#    设备上两者都是 not set，所以 IPC_NS 连符号都不可见。
#
#    ★ 这里用的是 POSIX_MQUEUE，不是 SYSVIPC ★
#      SYSVIPC 会给 struct task_struct 加 sysvsem/sysvshm 两个成员，
#      改变结构体布局 → ABI 崩（见文件开头"ABI 铁律"）。
#      POSIX_MQUEUE 只影响 fs/mqueue.c 的内部结构，布局安全。
#      Docker 需要的只是"有 IPC namespace 可以用"，POSIX_MQUEUE 足够满足依赖。
# -----------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# IPC namespace 的前置条件（设备上原本也是 not set）
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y


# -----------------------------------------------------------------------------
# 3. 网络 / 联合文件系统
#    VETH / BRIDGE / OVERLAY_FS 已经是 =y，列出便于校验。
#
#    ★ 不再开启 NF_TABLES / NF_TABLES_BRIDGE / BRIDGE_NETFILTER ★
#      NF_TABLES 会给 struct net 加成员（ABI 崩，见开头）。
#      好消息：本内核的 xtables（iptables 传统后端）全族是 =y 内建的 ——
#        NETFILTER_XTABLES=y  IP_NF_IPTABLES=y  IP_NF_FILTER=y
#        IP_NF_NAT=y  IP_NF_TARGET_MASQUERADE=y  NF_CONNTRACK=y  NF_NAT=y
#      所以 Docker 的 bridge/NAT 用 iptables-legacy 就能工作。
#      Ubuntu chroot 里如果 iptables 默认走 nft 后端，切一下即可：
#        update-alternatives --set iptables  /usr/sbin/iptables-legacy
#        update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
#      （BRIDGE_NETFILTER 只在"过滤同网桥内转发流量"时才需要，
#        容器访问外网走的是路由路径，不依赖它。）
# -----------------------------------------------------------------------------
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_OVERLAY_FS=y


# -----------------------------------------------------------------------------
# 4. 安全 / BPF
#    SECCOMP / SECCOMP_FILTER 定义在 arch/Kconfig，default y（本来就是开的）。
#    CGROUP_BPF / BPF_SYSCALL 已经是 =y。
# -----------------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y


# -----------------------------------------------------------------------------
# 5. ReSukiSU
#    5.10 属于 GKI2：默认用 kprobes hook，不需要 CONFIG_KSU_MANUAL_HOOK，
#    只要求 CONFIG_KPROBES=y（本内核已是 y）。
#    如果刷入后管理器显示未安装，再把 TRACEPOINT 打开重编（两者不要同时开）。
# -----------------------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_TOOLKIT_SUPPORT=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# CONFIG_KSU_TRACEPOINT_HOOK=y        # 可选：kprobes hook 不可用时启用
# CONFIG_KSU_SUSFS=y                  # 可选：需要自行打 susfs4ksu 内核补丁


# -----------------------------------------------------------------------------
# 6. 便于在手机上校验（可选但强烈建议）
#    没有这两个，/proc/config.gz 不存在，就只能靠 /proc/cgroups 反推。
#    （设备上本来就是 y，列在这里只是为了编译后校验。）
# -----------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y


# -----------------------------------------------------------------------------
# 7. 补齐与设备真实 .config 的差异（对齐官方构建）
#    【设备实测】reference/device-config.txt:7485 是 CONFIG_PAGE_EXTENSION=y，
#    但 gki_defconfig 里【没有这一行】（Kconfig 无 default y）→ 我们的合并
#    结果是 n（Run#7 与设备 diff 的 20 项差异之一）。补回来，减少与
#    "能启动的官方内核"的分歧面。
# -----------------------------------------------------------------------------
CONFIG_PAGE_EXTENSION=y
